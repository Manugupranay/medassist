# MedAssist AI — Environment Variables
# Copy this to .env and fill in your values

# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — for production database
# DATABASE_URL=postgresql://user:password@localhost/medassist

# Optional — for production vector store
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Optional — local server binding (read in backend/main.py)
# HOST defaults to 127.0.0.1. Set 0.0.0.0 only when the server has to be
# reachable from outside the machine (containers, LAN testing).
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true

# Optional — comma-separated CORS allowlist. Defaults to "*" for local
# development; pin this to real origins in any deployed environment.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
